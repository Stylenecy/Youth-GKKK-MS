# Keep the deployment upload to what actually builds the app.
#
# These directories hold real member data — WhatsApp exports, the member
# spreadsheet, meeting records, ministry notes. Nothing in src/ imports
# them, so there is no reason to ship ~22 MB of personal information to
# the build infrastructure on every deploy.
.agent/
database/
scripts/import/output/
Rapat/

# Spreadsheets with real member/steward data — local-only, never upload.
*.xlsx
# Exported CSVs carry real cash-book rows — never upload.
*.csv

# Local tool binaries / raw footage — not build inputs, would just bloat upload.
bin/
public/video/

# Working notes, not build inputs.
*.md
!README.md

# Tests and archived experiments are not build inputs either.
tests/
docs/
vitest.config.ts

# Local working files: process notes, screenshots, dev logs, editor config.
.dex/
*.log
.claude/

.next/
node_modules/
